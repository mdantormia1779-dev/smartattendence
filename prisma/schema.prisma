generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model attendance {
  id             String            @id
  employeeId     String
  date           DateTime          @db.Date
  checkInTime    DateTime?
  checkInMethod  AttendanceMethod?
  checkInLat     Decimal?          @db.Decimal(10, 7)
  checkInLng     Decimal?          @db.Decimal(10, 7)
  faceScore      Float?
  checkOutTime   DateTime?
  checkOutMethod AttendanceMethod?
  checkOutLat    Decimal?          @db.Decimal(10, 7)
  checkOutLng    Decimal?          @db.Decimal(10, 7)
  status         AttendanceStatus  @default(PRESENT)
  workedMinutes  Int?
  lateMinutes    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  employees      employees         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model audit_logs {
  id             String         @id
  actorId        String?
  actorEmail     String?
  actorRole      UserRole?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  organizationId String?
  superAdminId   String?
  createdAt      DateTime       @default(now())
  organizations  organizations? @relation(fields: [organizationId], references: [id])
  super_admins   super_admins?  @relation(fields: [superAdminId], references: [id])

  @@index([organizationId])
}

model branches {
  id             String        @id
  organizationId String
  name           String
  code           String
  address        String?
  phone          String?
  latitude       Decimal?      @db.Decimal(10, 7)
  longitude      Decimal?      @db.Decimal(10, 7)
  geoFenceRadius Int           @default(100)
  status         OrgStatus     @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments    departments[]
  employees      employees[]
  managers       managers[]
  shifts         shifts[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model coupons {
  id            String   @id
  code          String   @unique
  discountType  String
  discountValue Decimal  @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model departments {
  id             String        @id
  organizationId String
  branchId       String?
  name           String
  createdAt      DateTime      @default(now())
  branches       branches?     @relation(fields: [branchId], references: [id])
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      employees[]
  managers       managers[]

  @@index([organizationId])
}

model employee_documents {
  id         String    @id
  employeeId String
  type       String
  fileUrl    String
  uploadedAt DateTime  @default(now())
  employees  employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model employees {
  id                   String                 @id
  organizationId       String
  branchId             String
  departmentId         String?
  managerId            String?
  employeeCode         String
  fullName             String
  profilePicture       String?
  gender               String?
  dateOfBirth          DateTime?
  bloodGroup           String?
  maritalStatus        String?
  email                String
  password             String
  phone                String?
  address              String?
  emergencyContact     String?
  designation          String?
  joiningDate          DateTime?
  employmentType       EmploymentType         @default(FULL_TIME)
  status               EmployeeStatus         @default(ACTIVE)
  basicSalary          Decimal?               @db.Decimal(12, 2)
  salaryType           SalaryType             @default(MONTHLY)
  salaryGrade          String?
  hourlyRate           Decimal?               @db.Decimal(10, 2)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  attendance           attendance[]
  employee_documents   employee_documents[]
  branches             branches               @relation(fields: [branchId], references: [id])
  departments          departments?           @relation(fields: [departmentId], references: [id])
  managers             managers?              @relation(fields: [managerId], references: [id])
  organizations        organizations          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  face_profiles        face_profiles?
  fingerprint_profiles fingerprint_profiles[]
  leaves               leaves[]
  overtime             overtime[]
  payslips             payslips[]
  shift_assignments    shift_assignments[]
  tasks                tasks[]

  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([branchId])
  @@index([organizationId])
}

model face_profiles {
  id             String    @id
  employeeId     String    @unique
  descriptor     Json
  sampleImages   String[]
  livenessPassed Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  employees      employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model fingerprint_profiles {
  id         String    @id
  employeeId String
  deviceId   String?
  template   String
  createdAt  DateTime  @default(now())
  employees  employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model holidays {
  id             String        @id
  organizationId String
  name           String
  date           DateTime      @db.Date
  type           String
  createdAt      DateTime      @default(now())
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model leaves {
  id          String      @id
  employeeId  String
  type        LeaveType
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  reason      String?
  status      LeaveStatus @default(PENDING)
  managerId   String?
  managerNote String?
  orgNote     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  employees   employees   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  managers    managers?   @relation(fields: [managerId], references: [id])

  @@index([employeeId])
}

model managers {
  id             String        @id
  organizationId String
  branchId       String?
  departmentId   String?
  name           String
  profilePicture String?
  email          String
  password       String
  phone          String?
  designation    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  employees      employees[]
  leaves         leaves[]
  branches       branches?     @relation(fields: [branchId], references: [id])
  departments    departments?  @relation(fields: [departmentId], references: [id])
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
}

model notifications {
  id             String           @id
  organizationId String?
  recipientType  String
  recipientId    String
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  organizations  organizations?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, recipientId])
}

model org_admins {
  id             String        @id
  name           String
  email          String        @unique
  password       String
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  organizations  organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model organizations {
  id              String          @id
  name            String
  slug            String          @unique
  logoUrl         String?
  industry        String?
  email           String          @unique
  phone           String?
  website         String?
  address         String?
  country         String?
  language        String          @default("en")
  currency        String          @default("USD")
  timezone        String          @default("UTC")
  workingDays     Json?
  officeStart     String?
  officeEnd       String?
  status          OrgStatus       @default(PENDING)
  customDomain    String?         @unique
  customTheme     Json?
  customEmailFrom String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  audit_logs      audit_logs[]
  branches        branches[]
  departments     departments[]
  employees       employees[]
  holidays        holidays[]
  managers        managers[]
  notifications   notifications[]
  org_admins      org_admins[]
  payments        payments[]
  subscriptions   subscriptions?
  affiliate_referrals affiliate_referrals[]
  tasks           tasks[]
}

model overtime {
  id           String       @id
  employeeId   String
  date         DateTime     @db.Date
  type         OvertimeType @default(REGULAR)
  minutes      Int
  multiplier   Decimal      @default(1.5) @db.Decimal(4, 2)
  approved     Boolean      @default(false)
  approvedById String?
  createdAt    DateTime     @default(now())
  employees    employees    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model payments {
  id             String         @id
  organizationId String
  subscriptionId String?
  amount         Decimal        @db.Decimal(10, 2)
  currency       String         @default("USD")
  provider       String?
  status         String         @default("pending")
  invoiceUrl     String?
  couponCode     String?
  createdAt      DateTime       @default(now())
  organizations  organizations  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions  subscriptions? @relation(fields: [subscriptionId], references: [id])
  affiliate_commissions affiliate_commissions[]
}

model payslips {
  id                 String        @id
  employeeId         String
  month              Int
  year               Int
  basicSalary        Decimal       @db.Decimal(12, 2)
  houseRent          Decimal       @default(0) @db.Decimal(12, 2)
  medicalAllowance   Decimal       @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal       @default(0) @db.Decimal(12, 2)
  foodAllowance      Decimal       @default(0) @db.Decimal(12, 2)
  bonus              Decimal       @default(0) @db.Decimal(12, 2)
  overtimePay        Decimal       @default(0) @db.Decimal(12, 2)
  lateDeduction      Decimal       @default(0) @db.Decimal(12, 2)
  tax                Decimal       @default(0) @db.Decimal(12, 2)
  loanDeduction      Decimal       @default(0) @db.Decimal(12, 2)
  providentFund      Decimal       @default(0) @db.Decimal(12, 2)
  absentDeduction    Decimal       @default(0) @db.Decimal(12, 2)
  netSalary          Decimal       @db.Decimal(12, 2)
  status             PayrollStatus @default(DRAFT)
  pdfUrl             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  employees          employees     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

model shift_assignments {
  id            String    @id
  employeeId    String
  shiftId       String
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  employees     employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shifts        shifts    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model shifts {
  id                String              @id
  branchId          String
  name              String
  startTime         String
  endTime           String
  breakMinutes      Int                 @default(60)
  gracePeriod       Int                 @default(10)
  lateAfter         Int                 @default(15)
  createdAt         DateTime            @default(now())
  shift_assignments shift_assignments[]
  branches          branches            @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model subscription_plans {
  id              String               @id
  name            String
  type            SubscriptionPlanType @unique
  price           Decimal              @db.Decimal(10, 2)
  billingCycle    String               @default("monthly")
  maxBranches     Int?
  maxManagers     Int?
  maxEmployees    Int?
  faceRecognition Boolean              @default(false)
  gpsVerification Boolean              @default(false)
  fingerprint     Boolean              @default(false)
  payroll         Boolean              @default(false)
  analytics       Boolean              @default(false)
  apiAccess       Boolean              @default(false)
  whiteLabel      Boolean              @default(false)
  customDomain    Boolean              @default(false)
  prioritySupport Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime
  subscriptions   subscriptions[]
}

model subscriptions {
  id                 String             @id
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  autoRenew          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  payments           payments[]
  organizations      organizations      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription_plans subscription_plans @relation(fields: [planId], references: [id])
}

model super_admins {
  id         String       @id
  name       String
  email      String       @unique
  password   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  audit_logs audit_logs[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  UNPAID
}

enum OvertimeType {
  REGULAR
  WEEKEND
  HOLIDAY
  EMERGENCY
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum AttendanceMethod {
  FACE
  GPS
  FINGERPRINT
  MANUAL
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  APPROVED
  REJECTED
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SalaryType {
  MONTHLY
  HOURLY
  DAILY
}

enum SubscriptionPlanType {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  EMPLOYEE
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AffiliateCommissionType {
  ONE_TIME
  RECURRING_PERCENTAGE
}

enum AffiliateCommissionStatus {
  CREDITED
  PENDING
  CANCELLED
}

enum AffiliatePayoutMethod {
  BKASH
  NAGAD
  ROCKET
  BANK
}

enum AffiliatePayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

model affiliate_profiles {
  id              String                @id
  userId          String?
  fullName        String
  email           String                @unique
  phone           String
  nidNumber       String?
  nidDocumentUrl  String?
  referralCode    String?               @unique
  status          AffiliateStatus       @default(PENDING)
  balance         Decimal               @default(0) @db.Decimal(12, 2)
  totalEarned     Decimal               @default(0) @db.Decimal(12, 2)
  paymentMethod   AffiliatePayoutMethod @default(BKASH)
  paymentDetails  String?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  referrals       affiliate_referrals[]
  commissions     affiliate_commissions[]
  payouts         affiliate_payouts[]

  @@index([status])
  @@index([referralCode])
  @@index([email])
}

model affiliate_referrals {
  id                         String                @id
  affiliateId                String
  organizationId             String?
  referredEmail              String?
  status                     String                @default("ACTIVE")
  firstPaymentCommissionPaid Boolean               @default(false)
  totalRevenue               Decimal               @default(0) @db.Decimal(12, 2)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  affiliate                  affiliate_profiles    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  organization               organizations?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  commissions                affiliate_commissions[]

  @@index([affiliateId])
  @@index([organizationId])
}

model affiliate_commissions {
  id              String                    @id
  affiliateId     String
  referralId      String?
  amount          Decimal                   @db.Decimal(12, 2)
  ratePercentage  Decimal?                  @db.Decimal(5, 2)
  commissionType  AffiliateCommissionType
  sourcePaymentId String?
  status          AffiliateCommissionStatus @default(CREDITED)
  notes           String?
  createdAt       DateTime                  @default(now())

  affiliate       affiliate_profiles        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral        affiliate_referrals?      @relation(fields: [referralId], references: [id], onDelete: SetNull)
  payment         payments?                 @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@index([referralId])
}

model affiliate_payouts {
  id              String                @id
  affiliateId     String
  amount          Decimal               @db.Decimal(12, 2)
  payoutMethod    AffiliatePayoutMethod
  accountDetails  String
  status          AffiliatePayoutStatus @default(REQUESTED)
  transactionId   String?
  rejectionReason String?
  requestedAt     DateTime              @default(now())
  processedAt     DateTime?

  affiliate       affiliate_profiles    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
}

model affiliate_settings {
  id                     String   @id @default("global")
  oneTimeBonus           Decimal  @default(500) @db.Decimal(10, 2)
  recurringPercentage    Decimal  @default(10) @db.Decimal(5, 2)
  minimumPayoutThreshold Decimal  @default(500) @db.Decimal(10, 2)
  cookieDays             Int      @default(30)
  autoApprovePayouts     Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

enum ContactMessageStatus {
  UNREAD
  READ
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum ContactCategory {
  GENERAL
  SALES
  ENTERPRISE
  SUPPORT
  PARTNERSHIP
  BILLING
}

model contact_messages {
  id          String               @id
  name        String
  email       String
  phone       String?
  companyName String?
  category    ContactCategory      @default(GENERAL)
  subject     String
  message     String
  status      ContactMessageStatus @default(UNREAD)
  adminNotes  String?
  ipAddress   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model tasks {
  id              String        @id
  organizationId  String
  branchId        String?
  departmentId    String?
  employeeId      String
  assignedById    String
  assignedByName  String?
  assignedByRole  UserRole
  title           String
  description     String?
  priority        TaskPriority  @default(MEDIUM)
  status          TaskStatus    @default(PENDING)
  dueDate         DateTime?
  startDate       DateTime?
  completedAt     DateTime?
  completionNotes String?
  attachmentUrl   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organizations   organizations @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees       employees     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([status])
  @@index([dueDate])
}

